# Valores de ejemplo, versionados. NO pongas credenciales reales aqui.
#
# Los valores reales van en .env.local, que git ignora y que existe en local,
# staging y produccion. .env.local sobreescribe a este fichero.
#
#   cp .env .env.local   # y rellena .env.local con tus credenciales
#
# Este fichero existe para que `npm ci` (que lanza `prisma generate`) y las
# herramientas funcionen en un clon recien hecho y en CI sin configurar nada.

# --- Base de datos ---
DATABASE_URL=postgresql://rocnest:rocnest@localhost:5432/rocnest
DIRECT_URL=postgresql://rocnest:rocnest@localhost:5432/rocnest

# --- Sesiones ---
# Deliberadamente vacio: la aplicacion falla al arrancar si no hay secreto.
# Es preferible a arrancar firmando sesiones con un valor que esta publicado
# en el repositorio, que permitiria falsificar sesiones a cualquiera.
# Genera el tuyo en .env.local con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- URLs publicas ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Base absoluta de los enlaces que van en los emails (invitaciones).
# Si se omite, se deduce de las cabeceras de la peticion.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AWS (S3 para imagenes y SES para email) ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
CLOUDFRONT_URL=

# --- Email transaccional (AWS SES) ---
# Region donde esta verificada la identidad remitente. Puede no coincidir con
# AWS_REGION: las identidades de SES son por region y no tienen por que vivir
# donde vive el bucket de S3. Si se omite, se usa AWS_REGION.
SES_REGION=eu-west-1
# Identidad verificada en SES. Sin esto no se envian emails: la aplicacion
# sigue funcionando y muestra el enlace de invitacion para compartirlo a mano.
SES_FROM_EMAIL=
SES_REPLY_TO_EMAIL=
SES_CONFIGURATION_SET=
