# Copia este fichero a .env y rellena tus valores.
# NUNCA subas .env al repositorio: contiene credenciales.

# --- Base de datos ---
DATABASE_URL=postgresql://usuario:password@localhost:5432/rocnest
DIRECT_URL=postgresql://usuario:password@localhost:5432/rocnest

# --- Sesiones ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- URLs publicas ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Base absoluta usada en los enlaces de los emails (invitaciones).
# Si se omite, se deduce de las cabeceras de la peticion.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AWS (S3 para imagenes y SES para email) ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
CLOUDFRONT_URL=

# --- Email transaccional (AWS SES) ---
# Identidad verificada en SES. Sin esto no se envian emails: la app sigue
# funcionando y muestra el enlace de invitacion para compartirlo a mano.
SES_FROM_EMAIL=RocNest <noreply@rocnest.app>
SES_REPLY_TO_EMAIL=
SES_CONFIGURATION_SET=
